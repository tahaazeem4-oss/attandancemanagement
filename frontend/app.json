{
  "expo": {
    "name": "EdTrack",
    "slug": "attendance-app",
    "scheme": "attendance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendanceapp.management",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan documents for uploads.",
        "NSPhotoLibraryUsageDescription": "Used to attach files from your photo library.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.attendanceapp.management",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "66a56650-1804-491d-8333-86f71633c870"
      }
    }
  }
}
