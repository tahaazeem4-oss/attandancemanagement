NODE_ENV=development
PORT=5000

# Comma-separated allowed web origins, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Use a strong random secret with at least 32 characters.
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# PostgreSQL / Supabase connection
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_with_db_password
DB_NAME=postgres
DB_SSL=true
DATABASE_URL=

# SMTP for password reset emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM_NAME=Attendance Management
SMTP_FROM_EMAIL=mailer@example.com

# Optional Expo push access token
EXPO_ACCESS_TOKEN=

# Optional bootstrap script setting
DEFAULT_PARENT_PASSWORD=